generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model School {
  id                String               @id @default(cuid())
  name              String
  createdAt         DateTime             @default(now())
  campuses          Campus[]
  users             User[]
  learners          Learner[]
  devices           Device[]
  settings          SchoolSetting[]
  observations      WelfareObservation[]
  cases             ConductCase[]
  assessments       Assessment[]
  biometricCaptures BiometricCapture[]
}

model Campus {
  id        String               @id @default(cuid())
  schoolId  String
  name      String
  district  String
  school    School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  users     User[]
  learners  Learner[]
  occasions AttendanceOccasion[]

  @@unique([schoolId, name])
}

model User {
  id                  String               @id @default(cuid())
  schoolId            String
  campusId            String?
  name                String
  email               String               @unique
  passwordHash        String
  role                String
  active              Boolean              @default(true)
  failedLoginAttempts Int                  @default(0)
  lockedUntil         DateTime?
  passwordChangedAt   DateTime             @default(now())
  mfaEnabled          Boolean              @default(false)
  mfaSecretEncrypted  String?
  lastLoginAt         DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  school              School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campus              Campus?              @relation(fields: [campusId], references: [id])
  auditEvents         AuditEvent[]
  messages            Message[]
  sessions            Session[]
  resetTokens         PasswordResetToken[]
  observations        WelfareObservation[] @relation("ObservationReporter")
  cases               ConductCase[]        @relation("CaseOwner")
  assessments         Assessment[]         @relation("AssessmentCreator")
}

model Learner {
  id                String                @id @default(cuid())
  schoolId          String
  campusId          String
  firstName         String
  lastName          String
  admissionNumber   String
  lin               String?
  className         String
  stream            String
  gender            String
  residence         String
  dateOfBirth       DateTime
  guardianName      String
  guardianPhone     String
  status            String                @default("active")
  enrolledOn        DateTime              @default(now())
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  school            School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campus            Campus                @relation(fields: [campusId], references: [id])
  credentials       QrCredential[]
  attendance        AttendanceRecord[]
  observations      WelfareObservation[]
  cases             ConductCase[]
  marks             Mark[]
  biometrics        BiometricCredential[]
  biometricCaptures BiometricCapture[]

  @@unique([schoolId, admissionNumber])
  @@index([schoolId, className, stream])
}

model QrCredential {
  id            String    @id @default(cuid())
  learnerId     String
  serialHash    String    @unique
  serialPreview String
  status        String    @default("active")
  issuedAt      DateTime  @default(now())
  issuedById    String
  revokedAt     DateTime?
  revokedReason String?
  learner       Learner   @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  @@index([learnerId, status])
}

model AttendanceOccasion {
  id                 String             @id @default(cuid())
  campusId           String
  name               String
  category           String
  location           String
  startsAt           DateTime
  endsAt             DateTime
  expected           Int
  status             String             @default("scheduled")
  responsibleStaffId String
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  campus             Campus             @relation(fields: [campusId], references: [id])
  records            AttendanceRecord[]
  biometricCaptures  BiometricCapture[]

  @@index([campusId, startsAt])
}

model Device {
  id                String             @id @default(cuid())
  schoolId          String
  name              String
  publicId          String             @unique
  secretHash        String
  secretVersion     Int                @default(1)
  secretRotatedAt   DateTime           @default(now())
  location          String
  status            String             @default("active")
  lastSyncAt        DateTime?
  createdAt         DateTime           @default(now())
  school            School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  records           AttendanceRecord[]
  syncBatches       SyncBatch[]
  sessions          DeviceSession[]
  capabilities      String             @default("qr")
  biometricCaptures BiometricCapture[]
}

model Session {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String    @unique
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  lastUsedAt       DateTime  @default(now())
  revokedAt        DateTime?
  revokedReason    String?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model DeviceSession {
  id        String    @id @default(cuid())
  deviceId  String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  device    Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, revokedAt])
}

model AttendanceRecord {
  id               String             @id @default(cuid())
  schoolId         String
  clientEventId    String?
  learnerId        String
  occasionId       String
  deviceId         String?
  status           String
  outcome          String             @default("accepted")
  recordedAt       DateTime
  recordedById     String
  source           String             @default("online")
  captureMethod    String             @default("qr")
  confidence       Float?
  livenessScore    Float?
  reconciliation   String             @default("not_required")
  createdAt        DateTime           @default(now())
  learner          Learner            @relation(fields: [learnerId], references: [id])
  occasion         AttendanceOccasion @relation(fields: [occasionId], references: [id])
  device           Device?            @relation(fields: [deviceId], references: [id])
  biometricCapture BiometricCapture?

  @@unique([schoolId, clientEventId])
  @@unique([learnerId, occasionId])
  @@index([schoolId, recordedAt])
}

model BiometricCredential {
  id                String             @id @default(cuid())
  learnerId         String
  modality          String
  provider          String
  providerReference String?
  status            String             @default("pending")
  qualityScore      Float?
  consentRecorded   Boolean            @default(false)
  consentAt         DateTime?
  consentBy         String?
  enrolledById      String
  enrolledAt        DateTime           @default(now())
  activatedAt       DateTime?
  revokedAt         DateTime?
  revokedReason     String?
  expiresAt         DateTime?
  learner           Learner            @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  captures          BiometricCapture[]

  @@unique([provider, providerReference])
  @@index([learnerId, modality, status])
}

model BiometricCapture {
  id                 String               @id @default(cuid())
  schoolId           String
  learnerId          String?
  occasionId         String
  deviceId           String
  credentialId       String?
  clientEventId      String
  modality           String
  provider           String
  providerEventId    String?
  confidence         Float?
  livenessScore      Float?
  qualityScore       Float?
  outcome            String
  reviewStatus       String               @default("not_required")
  reviewReason       String?
  reviewedById       String?
  reviewedAt         DateTime?
  capturedAt         DateTime
  attendanceRecordId String?              @unique
  createdAt          DateTime             @default(now())
  school             School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  learner            Learner?             @relation(fields: [learnerId], references: [id])
  device             Device               @relation(fields: [deviceId], references: [id])
  occasion           AttendanceOccasion   @relation(fields: [occasionId], references: [id])
  credential         BiometricCredential? @relation(fields: [credentialId], references: [id], onDelete: SetNull)
  attendanceRecord   AttendanceRecord?    @relation(fields: [attendanceRecordId], references: [id])

  @@unique([deviceId, clientEventId])
  @@index([schoolId, reviewStatus, capturedAt])
  @@index([learnerId, capturedAt])
}

model SyncBatch {
  id            String   @id @default(cuid())
  deviceId      String
  clientBatchId String
  received      Int
  accepted      Int
  rejected      Int
  syncedAt      DateTime @default(now())
  device        Device   @relation(fields: [deviceId], references: [id])

  @@unique([deviceId, clientBatchId])
}

model Message {
  id          String    @id @default(cuid())
  schoolId    String
  senderId    String
  channel     String
  recipients  String
  subject     String?
  body        String
  status      String    @default("queued")
  providerRef String?
  sentAt      DateTime?
  createdAt   DateTime  @default(now())
  sender      User      @relation(fields: [senderId], references: [id])

  @@index([schoolId, createdAt])
}

model AuditEvent {
  id            String   @id @default(cuid())
  schoolId      String
  actorId       String?
  action        String
  entityType    String
  entityId      String?
  beforeJson    String?
  afterJson     String?
  ipAddress     String?
  userAgent     String?
  correlationId String
  createdAt     DateTime @default(now())
  actor         User?    @relation(fields: [actorId], references: [id])

  @@index([schoolId, createdAt])
  @@index([entityType, entityId])
}

model WelfareObservation {
  id         String    @id @default(cuid())
  schoolId   String
  learnerId  String
  reporterId String
  category   String
  severity   String
  summary    String
  details    String
  status     String    @default("open")
  occurredAt DateTime
  reviewAt   DateTime?
  closedAt   DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  school     School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  learner    Learner   @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  reporter   User      @relation("ObservationReporter", fields: [reporterId], references: [id])

  @@index([schoolId, status, occurredAt])
  @@index([learnerId, occurredAt])
}

model ConductCase {
  id         String    @id @default(cuid())
  schoolId   String
  learnerId  String
  ownerId    String
  reference  String
  title      String
  allegation String
  status     String    @default("open")
  finding    String?
  rationale  String?
  closedAt   DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  school     School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  learner    Learner   @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  owner      User      @relation("CaseOwner", fields: [ownerId], references: [id])

  @@unique([schoolId, reference])
  @@index([schoolId, status])
}

model Assessment {
  id             String    @id @default(cuid())
  schoolId       String
  createdById    String
  name           String
  subject        String
  className      String
  term           String
  maximumMark    Int
  assessmentDate DateTime
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  school         School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdBy      User      @relation("AssessmentCreator", fields: [createdById], references: [id])
  marks          Mark[]

  @@index([schoolId, className, term])
}

model Mark {
  id           String     @id @default(cuid())
  assessmentId String
  learnerId    String
  score        Decimal?   @db.Decimal(6, 2)
  comment      String?
  updatedAt    DateTime   @updatedAt
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  learner      Learner    @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, learnerId])
}

model SchoolSetting {
  id        String   @id @default(cuid())
  schoolId  String
  key       String
  valueJson Json
  sensitive Boolean  @default(false)
  updatedAt DateTime @updatedAt
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, key])
}
